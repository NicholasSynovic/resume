
@misc{davisOpenSourceSoftware,
	title = {Open Source Software, Closed Software Factory},
	abstract = {Can software vendors disclose source code while retaining a development advantage in their software factories? Using generative {AI}, competitors are increasingly reverseengineering or replicating functionality, so source secrecy offers less protection as a “moat”. Offering source access may attract customers seeking assurance or interoperability without necessarily enabling recipients to maintain or extend the software at comparable cost. We conceptualize this as open source, closed factory, treating disclosure as a choice of engineering artifacts and evaluating its effects on development cost. We introduce the factory multiplier, an end-to-end engineering cost ratio, and propose comparing it across three task classes: replication, modification, and evolution. We hypothesize that coding agents will reduce the cost of replication and specified modifications, but that evolving software under ambiguous requirements and changing environments will remain more expensive without the originating factory’s accumulated engineering knowledge. We propose experiments that selectively remove engineering artifacts from originating factories or provide them to recipients, measuring how these changes affect development costs and whether increasingly capable agents can compensate for missing artifacts.},
	author = {Davis, James C and Jiang, Wenxin and Synovic, Nicholas and Thiruvathukal, George K},
	langid = {english},
	file = {PDF:/home/nicholas/Zotero/storage/MTFYISW7/Davis et al. - Open Source Software, Closed Software Factory.pdf:application/pdf},
}
