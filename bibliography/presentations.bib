
@unpublished{thiruvathukalSnapshotMetricsAre2022,
	location = {Loyola University Chicago, Cueno Hall Room 312},
	title = {Snapshot Metrics Are Not Enough: Analyzing Software Repositories with Longitudinal Metrics Presentation},
	rights = {All rights reserved},
	url = {https://www.luc.edu/datascience/events/datascienceseminar/},
	abstract = {Software metrics capture information about software development processes and products. These metrics support decision-making, e.g., in team management or dependency selection. However, existing metrics tools measure only a snapshot of a software project. Little attention has been given to enabling engineers to reason about metric trends over time -- longitudinal metrics that give insight about process, not just product. In this work, we present {PRiME} ({PRocess} {MEtrics}), a tool for computing and visualizing process metrics. The currently-supported metrics include productivity, issue density, issue spoilage, and bus factor, all of which can help to understand the “health” of a software development effort.},
	type = {Seminar},
	howpublished = {Seminar},
	note = {Data Science Seminar},
	author = {Thiruvathukal, George K and Synovic, Nicholas},
	date = {2022-03-30},
	keywords = {{ZotMeta}: Skipped},
}

@unpublished{synovicScODAEmergingPipeline,
	location = {St Louis {MO} {USA}},
	title = {{ScODA}: An Emerging Pipeline for Evaluating Distributed Database Performance To Support Operational Data Analytics},
	url = {https://sc25.supercomputing.org/proceedings/posters/poster_pages/post221.html},
	doi = {10.6084/m9.figshare.34998169},
	shorttitle = {{ScODA}},
	abstract = {As high-performance computing ({HPC}) systems scale toward the exascale era, operational data analytics ({ODA}) play an increasingly central role in managing system security, health, scheduling, and scientific productivity. Supercomputing facilities continuously generate massive volumes of logs and system metrics. To make actionable insights, distributed database management systems ({DBMSs}) are often employed, but their behavior under realistic production {HPC} workloads remains underexplored. This poster presents {SCODA} (Supercomputing Operational Data Analytics), an emerging benchmarking pipeline designed to evaluate distributed {DBMS} solutions—including relational, document, timeseries databases and lakehouse solutions—using real and synthetic {HPC} environment logs. By working alongside our business intelligence colleagues to systematically model and implement common {ODA} workflows, {SCODA} enables data-driven comparisons of competing {DBMS} platforms and identifies trade-offs in ingestion, querying, and concurrent access. We present our methodology, preliminary benchmarks, and lessons learned from applying {SCODA} to multiple {DBMS} platforms at Argonne National Laboratory.},
	type = {Poster},
	howpublished = {Poster},
	author = {Synovic, Nicholas and Thiruvathukal, George K. and Shilpika and Rizzi, Silvio and Waldron, Doug and Papka, Michael E.},
	urldate = {2026-11-12},
	date = {2025-11-18},
	langid = {english},
}

